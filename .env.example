# ================================================================
# Wayfarer AI - Environment Variables Configuration
# ================================================================

# Groq LLM API Key (Get free key from https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# Groq Model Name (Default: openai/gpt-oss-120b or qwen/qwen3.8-27b)
GROQ_MODEL=openai/gpt-oss-120b

# Tavily Search API Key for Hotel MCP Agent (Get free key from https://tavily.com)
TAVILY_API_KEY=your_tavily_api_key_here

# AviationStack API Key for Flight MCP Agent (Get free key from https://aviationstack.com)
AVIATIONSTACK_API_KEY=your_aviationstack_api_key_here

# OpenWeather API Key for Weather MCP Agent (Get free key from https://openweathermap.org/api)
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Default Departure Airport IATA Code (e.g., DAC for Dhaka, DEL for Delhi, JFK for New York, LHR for London)
DEFAULT_ORIGIN_IATA=DAC

# PostgreSQL Database URL for LangGraph Checkpointer
# Format: postgresql://username:password@hostname:5432/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@host.neon.tech/neondb?sslmode=require
